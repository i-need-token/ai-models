{
  "name": "ai-models",
  "version": "0.2.0",
  "description": "Structured YAML catalog of 4,587 AI models across 95 providers — pricing, context windows, modalities, capabilities. First-party data with TypeScript types and Zod validation.",
  "keywords": [
    "agentic-models",
    "ai-agents",
    "ai-catalog",
    "ai-directory",
    "ai-model-pricing",
    "ai-models",
    "ai-pricing",
    "ai-provider",
