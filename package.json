{
  "name": "ai-models",
  "version": "0.1.0",
  "description": "A structured catalog of AI model providers and their models",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "sync": "npx tsx scripts/sync.ts",
    "validate": "npx tsx scripts/validate.ts",
    "fmt": "oxfmt",
